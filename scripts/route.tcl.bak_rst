set_thread_count [exec nproc]
source scripts/common.tcl
read_db results/cts.odb
read_liberty $scl(lib,typ)
read_liberty $pads(typ)
read_sdc constraints/doorbell.sdc
scl_set_parasitics
set_propagated_clock [all_clocks]
estimate_parasitics -placement

source scripts/skip_port_nets.tcl
set_routing_layers -signal metal1-metal2 -clock metal1-metal2
# These two change the database; run them once per fresh cts.odb only.
scl_correct_router_pin_abstracts
scl_add_cell_via_keepouts

global_route -use_cugr -critical_nets_percentage 0 -guide_file results/route.guide -verbose
detailed_route -output_drc reports/route_pass1.rpt -droute_end_iter 30 -verbose 1

write_db  results/route_pass1.odb
write_def results/route_pass1.def
puts "CP8D ROUTING PASS1 COMPLETED"
