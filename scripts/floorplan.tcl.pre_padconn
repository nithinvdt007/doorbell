# ---------- CP8D chip floorplan: pad ring + core + PDN ----------
# Derived from the project's floorplan that ran successfully. Changes: paths come
# from common.tcl, geometry from geometry.tcl, tracks from the PDK's tracks.info.
source scripts/common.tcl
source scripts/geometry.tcl

set DESIGN doorbell_chip
read_lef $scl(tech_lef)
read_lef $scl(cell_lef)
read_lef libs/pads_cp8d_snapped.lef
read_liberty $scl(lib,typ)
read_liberty $pads(typ)
read_verilog results/mapped.v
link_design $DESIGN
read_sdc constraints/doorbell.sdc

initialize_floorplan -die_area "0 0 $DIE_W $DIE_H" \
                     -core_area "$CORE_LO $CORE_LO $CORE_HI $CORE_HI" -site $scl(site)

# Every other row removed: the empty rows become the metal1 routing channels a
# 2-metal process needs (SCL reference floorplan).
set row_index 0
foreach row [[ord::get_db_block] getRows] {
    if { $row_index % 2 != 0 } { odb::dbRow_destroy $row }
    incr row_index
}
puts "Removed every other row."

# Routing tracks from the PDK (libs.tech/openlane/tracks.info), as the reference flow
foreach {layer grid} $scl(tracks) {
    lassign $grid x_offset x_pitch y_offset y_pitch
    make_tracks $layer -x_offset $x_offset -x_pitch $x_pitch -y_offset $y_offset -y_pitch $y_pitch
}

# ---------- Pad ring ----------
set block  [ord::get_db_block]
set dbu    [$block getDbUnitsPerMicron]
set CORNER 304.9
set GRID   0.1

proc pin_ymid {master pin} {
    set mt [$master findMTerm $pin]
    set sum 0.0
    set n 0
    foreach mp [$mt getMPins] {
        foreach box [$mp getGeometry] {
            set sum [expr {$sum + ([$box yMin] + [$box yMax]) / 2.0}]
            incr n
        }
    }
    return [expr {$sum / $n}]
}

# Which end of the pad cell faces the core: compare OUT1 (core side) with PADIN (bond pad)
set m_in [[$block findInst u_pad_clk] getMaster]
set core_on_top [expr {[pin_ymid $m_in OUT1] > [pin_ymid $m_in PADIN]}]
puts "PAD CONVENTION: core side is the [expr {$core_on_top ? {TOP} : {BOTTOM}}] of the pad cell"

proc place_side {side names} {
    global block dbu DIE_W DIE_H CORNER GRID core_on_top PAD_GAP
    set total 0
    set gap [expr {int(round($PAD_GAP * $dbu))}]
    foreach n $names {
        set inst [$block findInst $n]
        if {$inst eq "NULL"} { error "pad instance $n not found" }
        set total [expr {$total + [[$inst getMaster] getWidth]}]
    }
    set total [expr {$total + $gap * ([llength $names] - 1)}]
    set depth [[[$block findInst [lindex $names 0]] getMaster] getHeight]
    set cor   [expr {int(round($CORNER * $dbu))}]
    set grid  [expr {int(round($GRID * $dbu))}]
    if {$side eq "W" || $side eq "E"} {
        set len [expr {int(round($DIE_H * $dbu))}]
    } else {
        set len [expr {int(round($DIE_W * $dbu))}]
    }
    set pos [expr {$cor + ($len - 2 * $cor - $total) / 2}]
    set pos [expr {($pos / $grid) * $grid}]
    foreach n $names {
        set inst [$block findInst $n]
        set w [[$inst getMaster] getWidth]
        switch $side {
            W { set o [expr {$core_on_top ? "R270" : "R90"}]
                set x 0
                set y $pos }
            E { set o [expr {$core_on_top ? "R90" : "R270"}]
                set x [expr {int(round($DIE_W * $dbu)) - $depth}]
                set y $pos }
            S { set o [expr {$core_on_top ? "R0" : "MX"}]
                set x $pos
                set y 0 }
            N { set o [expr {$core_on_top ? "R180" : "R0"}]
                set x $pos
                set y [expr {int(round($DIE_H * $dbu)) - $depth}] }
        }
        $inst setOrient $o
        $inst setLocation $x $y
        $inst setPlacementStatus FIRM
        incr pos [expr {$w + $gap}]
        set bb [$inst getBBox]
        puts [format "PAD %-10s %s %-4s x %8.1f..%8.1f  y %8.1f..%8.1f" $n $side $o \
            [expr {[$bb xMin] / double($dbu)}] [expr {[$bb xMax] / double($dbu)}] \
            [expr {[$bb yMin] / double($dbu)}] [expr {[$bb yMax] / double($dbu)}]]
    }
}

source scripts/frame_pads.tcl

# ---------- PDN: core ring + rails + stripes ----------
add_global_connection -net VDD    -pin_pattern {^VDD$}    -power
add_global_connection -net GROUND -pin_pattern {^GROUND$} -ground
global_connect

set_voltage_domain -name CORE -power VDD -ground GROUND
define_pdn_grid -name stdcell_grid -starts_with POWER -voltage_domains CORE

add_pdn_ring -grid stdcell_grid -layers {metal1 metal2} \
    -widths {7.4 10.0} -spacings {7.4 7.8} -core_offsets {5.0 5.2}
add_pdn_stripe -grid stdcell_grid -layer metal1 -followpins -width 7.0 -extend_to_core_ring
add_pdn_connect -grid stdcell_grid -layers {metal1 metal2}
pdngen

write_db  results/floorplan.odb
write_def results/floorplan.def
report_design_area
puts "CP8D FLOORPLAN COMPLETED"
